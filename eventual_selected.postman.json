    {
      "name": "🔄 Search Reindex",
      "description": "Manage the Elasticsearch search index. Required once after initial database load, and again after bulk data imports.",
      "item": [
        {
          "name": "Trigger Reindex",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/search/reindex",
              "host": ["{{base_url}}"],
              "path": ["api", "search", "reindex"]
            },
            "description": "Start a full Elasticsearch reindex. Reads all events and groups from PostgreSQL, generates Ollama vector embeddings, and writes documents to the search index.\nReturns 202 Accepted immediately — the job runs in the background.\nReturns 409 Conflict if a reindex is already in progress.\nRequires authentication."
          }
        },
        {
          "name": "Get Reindex Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/search/reindex/status",
              "host": ["{{base_url}}"],
              "path": ["api", "search", "reindex", "status"]
            },
            "description": "Poll the status of the current or most recent reindex job.\nResponse fields: state (IDLE | RUNNING | COMPLETED | FAILED), eventsIndexed, groupsIndexed, eventsFailed, groupsFailed, totalEvents, totalGroups, startedAt, completedAt, error."
          }
        }
      ]
    }

