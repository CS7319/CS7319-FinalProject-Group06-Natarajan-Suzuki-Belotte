    {
      "name": "👥 Groups",
      "description": "Group management and join request workflow.",
      "item": [
        {
          "name": "Create Group (Public)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/groups",
              "host": ["{{base_url}}"],
              "path": ["api", "groups"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dallas Tech Enthusiasts\",\n  \"description\": \"A community for software engineers and tech professionals in Dallas.\",\n  \"is_public\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Create a public group. Requires ORGANIZER role.\nis_public=true: anyone can join immediately."
          }
        },
        {
          "name": "Create Group (Private)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/groups",
              "host": ["{{base_url}}"],
              "path": ["api", "groups"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Photography Club\",\n  \"description\": \"Exclusive group for serious photographers in the DFW area.\",\n  \"is_public\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Create a private group. Membership requires organizer approval. Requires ORGANIZER role."
          }
        },
        {
          "name": "Update Group",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/groups/{{group_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "groups", "{{group_id}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dallas Tech Enthusiasts\",\n  \"description\": \"The premier community for developers, designers, and tech founders in Dallas.\",\n  \"is_public\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Update group details. Requires ORGANIZER role."
          }
        },
        {
          "name": "Join Group",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/groups/{{group_id}}/join",
              "host": ["{{base_url}}"],
              "path": ["api", "groups", "{{group_id}}", "join"]
            },
            "description": "Join a group.\nPublic → 200 OK, immediately added.\nPrivate → 202 Accepted, creates a pending join request."
          }
        },
        {
          "name": "Get Pending Join Requests",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/groups/{{group_id}}/join-requests",
              "host": ["{{base_url}}"],
              "path": ["api", "groups", "{{group_id}}", "join-requests"]
            },
            "description": "List pending join requests for a group. Requires ORGANIZER role."
          }
        },
        {
          "name": "Approve Join Request",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/groups/{{group_id}}/join-requests/{{join_request_id}}/approve",
              "host": ["{{base_url}}"],
              "path": ["api", "groups", "{{group_id}}", "join-requests", "{{join_request_id}}", "approve"]
            },
            "description": "Approve a pending join request. Requires ORGANIZER role."
          }
        },
        {
          "name": "Reject Join Request",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/groups/{{group_id}}/join-requests/{{join_request_id}}/reject",
              "host": ["{{base_url}}"],
              "path": ["api", "groups", "{{group_id}}", "join-requests", "{{join_request_id}}", "reject"]
            },
            "description": "Reject a pending join request. Requires ORGANIZER role."
          }
        }
      ]
    },

    {
      "name": "🎟️ RSVPs",
      "description": "RSVP to events and manage attendance.",
      "item": [
        {
          "name": "RSVP to Event",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/events/{{event_id}}/rsvp",
              "host": ["{{base_url}}"],
              "path": ["api", "events", "{{event_id}}", "rsvp"]
            },
            "description": "RSVP to an event. Returns status GOING or WAITLISTED based on capacity."
          }
        },
        {
          "name": "Cancel RSVP",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/events/{{event_id}}/rsvp",
              "host": ["{{base_url}}"],
              "path": ["api", "events", "{{event_id}}", "rsvp"]
            },
            "description": "Cancel RSVP. Returns 200 OK with updated Rsvp object (status=CANCELLED). First WAITLISTED attendee is promoted automatically."
          }
        },
        {
          "name": "Get All RSVPs for Event",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/events/{{event_id}}/rsvp",
              "host": ["{{base_url}}"],
              "path": ["api", "events", "{{event_id}}", "rsvp"]
            },
            "description": "List all RSVPs for an event. Requires ORGANIZER role."
          }
        }
      ]
    },

