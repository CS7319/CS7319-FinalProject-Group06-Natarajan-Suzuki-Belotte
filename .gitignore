# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Elasticsearch local data volumes (bind-mounted by docker-compose)
unselected/docker/esdata01/*
unselected/docker/esdata02/*
unselected/docker/esdata03/*
selected/docker/esdata01/*
selected/docker/esdata02/*
selected/docker/esdata03/*
# Keep the directories themselves tracked
!unselected/docker/esdata01/.gitkeep
!unselected/docker/esdata02/.gitkeep
!unselected/docker/esdata03/.gitkeep
!selected/docker/esdata01/.gitkeep
!selected/docker/esdata02/.gitkeep
!selected/docker/esdata03/.gitkeep
